# Admin app settings (ADM-07). Copy this file to .env.local and fill in the values.
# All three are public: they are copied into the browser code. Never put a secret key here.
# The app refuses to start (dev, build or start) if a value is missing or wrong.

# Supabase project address. Local: `npx supabase status` in the backend folder shows it.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase PUBLISHABLE key (starts with sb_publishable_). Never the secret key (sb_secret_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend API address, without a trailing slash. Local backend: http://127.0.0.1:4000
# The backend only accepts calls from the admin address set in its ADMIN_URL
# (locally http://127.0.0.1:3101).
NEXT_PUBLIC_ADMIN_API_URL=http://127.0.0.1:4000
