# Trader website settings (WEB-03). Copy this file to .env.local and fill in the values.
# All four are public: they are copied into the browser code. Never put a secret key here.
# The site refuses to start (dev, build or start) if a value is missing or wrong.

# Supabase project address. Local: `npx supabase status` in the backend folder shows it.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase PUBLISHABLE key (starts with sb_publishable_). Never the secret key (sb_secret_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend API address, without a trailing slash. Local backend: http://127.0.0.1:4000
# The backend only accepts browser calls from the site address set in its APP_URL
# (locally http://127.0.0.1:3000).
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# This site's own address, without a path. Email links (verify email, reset password) are built
# from it, never from the request. Locally http://127.0.0.1:3000; it must also be allowed in
# Supabase's redirect settings.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
