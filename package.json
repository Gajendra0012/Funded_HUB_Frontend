{
  "name": "funded-hub-frontend",
  "private": true,
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "bun run --cwd apps/web typecheck",
    "test": "bun run --cwd apps/web test",
    "dev:admin": "bun run --cwd apps/admin dev",
    "start:admin": "bun run --cwd apps/admin start"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/web",
    "packages/ui"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
