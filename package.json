{
  "name": "funded-hub-frontend",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @funded-hub/web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @funded-hub/web start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev:admin": "pnpm --filter @funded-hub/admin dev",
    "start:admin": "pnpm --filter @funded-hub/admin start"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "typescript": "^5.9.3"
  }
}
